{
  "name": "grafeno-client",
  "version": "0.1.0",
  "description": "TypeScript client for the Grafeno HTTP API",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
